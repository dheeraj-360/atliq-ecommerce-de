{
	"name": "pl_atliq_nightly sync",
	"properties": {
		"description": "Master pipeline",
		"activities": [
			{
				"name": "run_bronze_ingestion",
				"description": "Runs the bronze ingestion pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "audit_run_started",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_atliq_bronze_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"p_run_start_at": {
							"value": "@variables('master_run_start_at')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "run_file_ingestion",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "audit_run_started",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_atliq_file_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Build_Silver",
				"description": "Run all silver transformations ",
				"type": "DatabricksJob",
				"dependsOn": [
					{
						"activity": "run_bronze_ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "run_file_ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"jobId": "862299923903882",
					"jobParameters": {
						"run_date": {
							"value": "@formatDateTime(variables('master_run_start_at'),'yyyy-MM-dd')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_atliq_databricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "set_master_run_start_at",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "master_run_start_at",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "audit_run_started",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "set_master_run_start_at",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[etl].[usp_log_pipeline_run]",
					"storedProcedureParameters": {
						"error_message": {
							"value": null,
							"type": "String"
						},
						"error_stage": {
							"value": null,
							"type": "String"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "String"
						},
						"run_date_utc": {
							"value": "@formatDateTime(variables('master_run_start_at'),'yyyy-MM-dd')",
							"type": "String"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"run_status": {
							"value": "Running",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azuresql_atliq_oltp",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "audit_run_succeeded",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Build_Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[etl].[usp_log_pipeline_run]",
					"storedProcedureParameters": {
						"error_message": {
							"value": null,
							"type": "String"
						},
						"error_stage": {
							"value": null,
							"type": "String"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "String"
						},
						"run_date_utc": {
							"value": "@formatDateTime(variables('master_run_start_at'),'yyyy-MM-dd')",
							"type": "String"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"run_status": {
							"value": "Succeeded",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azuresql_atliq_oltp",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "audit_run_failed",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Build_Silver",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[etl].[usp_log_pipeline_run]",
					"storedProcedureParameters": {
						"error_message": {
							"value": {
								"value": "@if(\n    equals(activity('run_bronze_ingestion').Status, 'Failed'),\n    activity('run_bronze_ingestion').error.message,\n    if(\n        equals(activity('run_file_ingestion').Status, 'Failed'),\n        activity('run_file_ingestion').error.message,\n        activity('Build_Silver').error.message\n    )\n)",
								"type": "Expression"
							},
							"type": "String"
						},
						"error_stage": {
							"value": {
								"value": "@if(\n    equals(activity('run_bronze_ingestion').Status, 'Failed'),\n    'run_bronze_ingestion',\n    if(\n        equals(activity('run_file_ingestion').Status, 'Failed'),\n        'run_file_ingestion',\n        'Build_Silver'\n    )\n)",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "String"
						},
						"run_date_utc": {
							"value": "@formatDateTime(variables('master_run_start_at'),'yyyy-MM-dd')",
							"type": "String"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "String"
						},
						"run_status": {
							"value": "Failed",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azuresql_atliq_oltp",
					"type": "LinkedServiceReference"
				}
			}
		],
		"variables": {
			"master_run_start_at": {
				"type": "String"
			}
		},
		"annotations": []
	}
}