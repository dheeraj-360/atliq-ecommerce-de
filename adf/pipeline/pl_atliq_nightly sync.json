{
	"name": "pl_atliq_nightly sync",
	"properties": {
		"description": "Master pipeline",
		"activities": [
			{
				"name": "run_bronze_ingestion",
				"description": "Runs the bronze ingestion pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "set_master_run_start_at",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_atliq_bronze_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "run_file_ingestion",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "set_master_run_start_at",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_atliq_file_ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Build_Silver",
				"description": "Run all silver transformations ",
				"type": "DatabricksJob",
				"dependsOn": [
					{
						"activity": "run_bronze_ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "run_file_ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"jobId": "862299923903882",
					"jobParameters": {
						"run_date": {
							"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_atliq_databricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "set_master_run_start_at",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "master_run_at",
					"value": "@utcNow()"
				}
			}
		],
		"variables": {
			"master_run_at": {
				"type": "String"
			}
		},
		"annotations": []
	}
}